static uint32_t D_0002613C;
/* the module's scratch words after the code (0x26760-0x26793): the unpacker stores the header word at 0x26790
 * and a zero halfword at 0x2678E, then reads that halfword back as a trailing-literal count (always 0) */
static uint32_t D_00026760[13];
#define D_00026790 (D_00026760[12])
