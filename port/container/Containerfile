# Build environment for the Driver 1 PC port, used by ./driver1.sh setup.
# Ubuntu 24.04 with the 32-bit (i386) SDL2 and OpenAL development packages, a multilib GCC, CMake,
# and splat at the versions this repo was built with. Nothing from the game is in here: the repo and
# your unpacked disc are mounted in at run time.
FROM docker.io/library/ubuntu:24.04

RUN dpkg --add-architecture i386 \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      gcc-multilib g++-multilib cmake make pkg-config python3 python3-venv ca-certificates \
      libsdl2-dev:i386 libopenal-dev:i386 \
      libx11-6:i386 libxext6:i386 libxcursor1:i386 libxi6:i386 libxfixes3:i386 libxrandr2:i386 \
      libxss1:i386 libxkbcommon0:i386 libwayland-client0:i386 libwayland-cursor0:i386 \
      libwayland-egl1:i386 libdecor-0-0:i386 libpulse0:i386 libasound2t64:i386 libdbus-1-3:i386 \
 && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir \
      splat64==0.50.1 spimdisasm==1.42.4 rabbitizer==1.16.2 pyelftools==0.33 crunch64==0.6.2 \
      intervaltree==3.1.0 PyYAML==6.0.3 n64img==0.3.3 pygfxd==1.0.5 tqdm==4.67.1 colorama==0.4.6
